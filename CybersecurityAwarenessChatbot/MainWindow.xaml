<Window x:Class="CybersecurityAwarenessChatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CybersecurityAwarenessChatbot"
        mc:Ignorable="d"
        Title="SecureWin Cybersecurity Assistant"
        Height="950"
        Width="1600"
        WindowStartupLocation="CenterScreen"
        Background="#07111F"
        WindowState="Maximized">

    <!-- ========================================================= -->
    <!-- RESOURCES -->
    <!-- ========================================================= -->

    <Window.Resources>

        <!-- SEND BUTTON STYLE -->
        <Style x:Key="CyberButton" TargetType="Button">

            <Setter Property="Background" Value="#00C2FF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>

        </Style>

    </Window.Resources>

    <!-- ========================================================= -->
    <!-- MAIN GRID -->
    <!-- ========================================================= -->

    <Grid Margin="12">

        <Grid.RowDefinitions>

            <!-- HEADER -->
            <RowDefinition Height="150"/>

            <!-- CHAT -->
            <RowDefinition Height="*"/>

            <!-- INPUT -->
            <RowDefinition Height="120"/>

        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- HEADER -->
        <!-- ========================================================= -->

        <Border Grid.Row="0"
                Background="#081520"
                BorderBrush="#00C2FF"
                BorderThickness="2"
                CornerRadius="18"
                Padding="10">

            <Grid>

                <Grid.ColumnDefinitions>

                    <!-- LEFT -->
                    <ColumnDefinition Width="3*"/>

                    <!-- RIGHT -->
                    <ColumnDefinition Width="2*"/>

                </Grid.ColumnDefinitions>

                <!-- ================================================= -->
                <!-- LEFT SIDE -->
                <!-- ================================================= -->

                <StackPanel Grid.Column="0">

                    <TextBlock Text="🔒 SECUREWIN CYBERSECURITY ASSISTANT 🔒"
                               Foreground="#00E5FF"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,5"/>

                    <TextBlock x:Name="AsciiArtText"
                               Text="SECUREWIN"
                               Foreground="#00E5FF"
                               FontFamily="Consolas"
                               FontSize="10"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"/>

                </StackPanel>

                <!-- ================================================= -->
                <!-- RIGHT SIDE -->
                <!-- ================================================= -->

                <Border Grid.Column="1"
                        Background="#0D1B2A"
                        CornerRadius="15"
                        Margin="10,0,0,0"
                        Padding="10">

                    <StackPanel>

                        <TextBlock Text="🛡️ AVAILABLE FEATURES"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10"/>

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>

                            </Grid.ColumnDefinitions>

                            <!-- COLUMN 1 -->
                            <StackPanel Grid.Column="0">

                                <TextBlock Text="✅ Malware Protection"
                                           Foreground="White"
                                           FontSize="12"
                                           Margin="0,4"/>

                                <TextBlock Text="✅ VPN Security"
                                           Foreground="White"
                                           FontSize="12"
                                           Margin="0,4"/>

                                <TextBlock Text="✅ Ransomware Safety"
                                           Foreground="White"
                                           FontSize="12"
                                           Margin="0,4"/>

                            </StackPanel>

                            <!-- COLUMN 2 -->
                            <StackPanel Grid.Column="1">

                                <TextBlock Text="✅ Sentiment Detection"
                                           Foreground="White"
                                           FontSize="12"
                                           Margin="0,4"/>

                                <TextBlock Text="✅ Smart Conversations"
                                           Foreground="White"
                                           FontSize="12"
                                           Margin="0,4"/>

                                <TextBlock Text="✅ Emoji Messaging"
                                           Foreground="White"
                                           FontSize="12"
                                           Margin="0,4"/>

                            </StackPanel>

                            <!-- COLUMN 3 -->
                            <StackPanel Grid.Column="2">

                                <TextBlock Text="✅ Password Safety Tips"
                                           Foreground="White"
                                           FontSize="12"
                                           Margin="0,4"/>

                                <TextBlock Text="✅ Phishing Detection"
                                           Foreground="White"
                                           FontSize="12"
                                           Margin="0,4"/>

                                <TextBlock Text="✅ Scam Awareness"
                                           Foreground="White"
                                           FontSize="12"
                                           Margin="0,4"/>

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

        <!-- ========================================================= -->
        <!-- CHAT AREA -->
        <!-- ========================================================= -->

        <Border Grid.Row="1"
                Margin="0,12"
                Background="White"
                CornerRadius="15"
                BorderBrush="#00C2FF"
                BorderThickness="2"
                Padding="10">

            <ScrollViewer x:Name="ChatScrollViewer"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel x:Name="ChatPanel"/>

            </ScrollViewer>

        </Border>

        <!-- ========================================================= -->
        <!-- INPUT AREA -->
        <!-- ========================================================= -->

        <Border Grid.Row="2"
                Background="#081520"
                CornerRadius="18"
                BorderBrush="#00C2FF"
                BorderThickness="2"
                Padding="10">

            <Grid>

                <Grid.ColumnDefinitions>

                    <!-- TEXTBOX -->
                    <ColumnDefinition Width="*"/>

                    <!-- BUTTON -->
                    <ColumnDefinition Width="160"/>

                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>

                    <!-- INPUT -->
                    <RowDefinition Height="60"/>

                    <!-- FOOTER -->
                    <RowDefinition Height="30"/>

                </Grid.RowDefinitions>

                <!-- ================================================= -->
                <!-- USER INPUT -->
                <!-- ================================================= -->

                <TextBox x:Name="UserInputTextBox"
                         Grid.Row="0"
                         Grid.Column="0"
                         Height="60"
                         FontSize="20"
                         Padding="15"
                         Margin="0,0,10,0"
                         Foreground="Gray"
                         Background="White"
                         BorderBrush="#00C2FF"
                         BorderThickness="2"
                         CaretBrush="Black"
                         VerticalAlignment="Center"
                         Text="Type your message here..."
                         GotFocus="UserInputTextBox_GotFocus"
                         LostFocus="UserInputTextBox_LostFocus"
                         KeyDown="UserInputTextBox_KeyDown"/>

                <!-- ================================================= -->
                <!-- SEND BUTTON -->
                <!-- ================================================= -->

                <Button Grid.Row="0"
                        Grid.Column="1"
                        x:Name="SendButton"
                        Content="📨 SEND"
                        Style="{StaticResource CyberButton}"
                        Height="60"
                        Width="150"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Click="SendButton_Click"/>

                <!-- ================================================= -->
                <!-- FOOTER -->
                <!-- ================================================= -->

                <TextBlock Grid.Row="1"
                           Grid.ColumnSpan="2"
                           Text="🛡️ Protecting South African Citizens Online 🛡️"
                           Foreground="White"
                           FontSize="14"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,5,0,0"/>

            </Grid>

        </Border>

    </Grid>

</Window>