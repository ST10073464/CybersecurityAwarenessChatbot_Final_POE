<Window x:Class="CybersecurityAwarenessChatbot.QuizWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Quiz"
        Height="700"
        Width="1000"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#10263A">

        <StackPanel Margin="30">

            <TextBlock Text="🎮 Cybersecurity Quiz"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <Border Background="#1A3A57"
                    CornerRadius="15"
                    Padding="20">

                <StackPanel>

                    <TextBlock x:Name="QuestionText"
                               FontSize="20"
                               Foreground="White"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20"/>

                    <Button x:Name="Option1Button"
                            Height="45"
                            Margin="0,5"
                            Click="Option_Click"/>

                    <Button x:Name="Option2Button"
                            Height="45"
                            Margin="0,5"
                            Click="Option_Click"/>

                    <Button x:Name="Option3Button"
                            Height="45"
                            Margin="0,5"
                            Click="Option_Click"/>

                    <Button x:Name="Option4Button"
                            Height="45"
                            Margin="0,5"
                            Click="Option_Click"/>

                    <TextBlock x:Name="ResultText"
                               Margin="0,20"
                               FontSize="18"
                               Foreground="White"
                               TextWrapping="Wrap"/>

                    <StackPanel x:Name="ResultButtons" Visibility="Collapsed">
                        <Button x:Name="BackToQuizButton"
                            Content="⬅ Back to Quiz"
                            Width="180"
                            Height="40"
                            Margin="10"
                           
                            Click="BackToQuizButton_Click"/>
                    </StackPanel>

                </StackPanel>

            </Border>


            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,20">

                <Button Content="🔄 Retry Quiz"
                        Width="150"
                        Height="40"
                        Margin="5"
                        Click="RetryButton_Click"/>

                <Button Content="🏠 Main Menu"
                        Width="150"
                        Height="40"
                        Margin="5"
                        Click="MenuButton_Click"/>
                

            </StackPanel>

        </StackPanel>

    </Grid>
</Window>