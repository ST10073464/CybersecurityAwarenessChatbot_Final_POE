<Window x:Class="CybersecurityAwarenessChatbot.QuizWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Title="Quiz Mode"
         WindowState="Maximized"
         Background="#07111F"
         WindowStartupLocation="CenterScreen">

    
    <Grid Margin="20">

        <!-- ================================================= -->
        <!-- ROWS -->
        <!-- ================================================= -->

        <Grid.RowDefinitions>

            <!-- Header -->
            <RowDefinition Height="Auto"/>

            <!-- Main Content -->
            <RowDefinition Height="*"/>

            <!-- Footer -->
            <RowDefinition Height="35"/>

        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <StackPanel Grid.Row="0"
                    Margin="0,0,0,15">

            <TextBlock x:Name="UserNameText"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,10"/>

            <TextBlock Text="🎮 Cybersecurity Quiz"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"/>

            <TextBlock x:Name="ProgressText"
                       FontSize="16"
                       Foreground="#00E5FF"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="20">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto"/>

                    <RowDefinition Height="*"/>

                    <RowDefinition Height="Auto"/>

                </Grid.RowDefinitions>

                <!-- QUESTION -->

                <TextBlock x:Name="PlaceholderText"
                           Text="📝 Answer the cybersecurity questions by selecting one option and clicking Next."
                           Foreground="Gray"
                           FontSize="16"
                           FontStyle="Italic"
                           Margin="0,0,0,10"/>


                <TextBlock x:Name="QuestionText"
                           Grid.Row="0"
                           FontSize="24"
                           FontWeight="Bold"
                           TextWrapping="Wrap"
                           Margin="0,0,0,20"/>

                <!-- ANSWERS -->

                <ListBox x:Name="AnswerListBox"
                         Grid.Row="1"
                         FontSize="18"
                         Margin="0,0,0,20"/>

                <!-- RESULTS -->

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto">

                    <TextBlock x:Name="ResultsText"
                               FontSize="18"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </ScrollViewer>

                <!-- BUTTONS -->

                <StackPanel Grid.Row="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center">

                    <Button x:Name="NextButton"
                            Content="Next Question"
                            Width="180"
                            Height="45"
                            Margin="10"
                            Click="NextButton_Click"/>

                    <Button x:Name="RetryButton"
                            Content="Retry Wrong Answers"
                            Width="200"
                            Height="45"
                            Margin="10"
                            Visibility="Collapsed"
                            Click="RetryButton_Click"/>

                    <Button x:Name="BackButton"
                            Content="⬅ Back to Menu"
                            Width="180"
                            Height="45"
                            Margin="10"
                            Visibility="Collapsed"
                            Click="BackButton_Click"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- ================================================= -->
        <!-- FOOTER -->
        <!-- ================================================= -->

        <Border Grid.Row="2"
                Background="#10263A">

            <TextBlock
                    Text="🛡️ Protecting South African Citizens Online 🛡️"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

        </Border>

    </Grid>

</Window>
