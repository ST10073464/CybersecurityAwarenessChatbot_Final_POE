<Window x:Class="CybersecurityAwarenessChatbot.TaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Assistant"
        Height="700"
        Width="1200">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="HeaderText"
            Grid.Row="0"
            FontSize="24"
            FontWeight="Bold"/>

        <ListBox
            x:Name="TaskListBox"
            Grid.Row="1"/>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Center">

            <Button Content="Add Task"
                    Width="120"
                    Margin="5"
                    Click="AddTask_Click"/>

            <Button Content="Refresh"
                    Width="120"
                    Margin="5"
                    Click="Refresh_Click"/>

            <Button Content="Back"
                    Width="120"
                    Margin="5"
                    Click="Back_Click"/>

        </StackPanel>

    </Grid>

</Window>