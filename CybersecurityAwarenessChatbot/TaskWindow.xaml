<Window x:Class="CybersecurityAwarenessChatbot.TaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Assistant"
        WindowState="Maximized"
        Background="#07111F">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <Border Grid.Row="0"
                Background="#10263A">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>

                <!-- BACK -->

                <Button Grid.Column="0"
                        Content="⬅ Back"
                        Margin="10"
                        Click="Back_Click"/>

                <!-- TITLE -->

                <TextBlock Grid.Column="1"
                           Text="📋 Cybersecurity Task Assistant"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"/>

                <!-- USER -->

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="15">

                    <Ellipse Width="14"
                             Height="14"
                             Fill="LimeGreen"
                             VerticalAlignment="Center"/>

                    <TextBlock x:Name="UserNameText"
                               Foreground="White"
                               FontSize="16"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- MAIN AREA -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <!-- LEFT MENU -->
                <ColumnDefinition Width="220"/>

                <!-- CHAT -->
                <ColumnDefinition Width="*"/>

                <!-- RIGHT HELP PANEL -->
                <ColumnDefinition Width="280"/>

            </Grid.ColumnDefinitions>

            <!-- LEFT SIDE MENU -->

            <Border Grid.Column="0"
                    Background="white"
                    Margin="10"
                    CornerRadius="10">

                <StackPanel>

                    <TextBlock Text="TASK MENU"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="15"/>

                    <TextBlock Text="➕ Add Task"
                               Cursor="Hand"
                               Margin="15"
                               MouseDown="AddTaskOption_Click"/>

                    <TextBlock Text="📋 View Tasks"
                               Cursor="Hand"
                               Margin="15"
                               MouseDown="ViewTasksOption_Click"/>

                    <TextBlock Text="✅ Complete Task"
                               Cursor="Hand"
                               Margin="15"
                               MouseDown="CompleteTaskOption_Click"/>

                    <TextBlock Text="🗑 Delete Task"
                               Cursor="Hand"
                               Margin="15"
                               MouseDown="DeleteTaskOption_Click"/>

                </StackPanel>

            </Border>

            <!-- CHAT AREA -->

            <Border Grid.Column="1"
                    Margin="10"
                    Background="LightGray"
                    CornerRadius="15">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="*"/>

                        <RowDefinition Height="80"/>

                    </Grid.RowDefinitions>

                    <!-- Messages -->

                    <ScrollViewer x:Name="ChatScrollViewer"
                                  Grid.Row="0">

                        <StackPanel x:Name="ChatPanel"/>

                    </ScrollViewer>

                    <!-- SAME INPUT AREA AS CHAT WINDOW -->

                    <Border Grid.Row="1"
                            Margin="10"
                            Background="White"
                            CornerRadius="30">

                        <Grid>

                            <TextBox x:Name="UserInputTextBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="18"
                                     Padding="20,0,70,0"
                                     VerticalContentAlignment="Center"
                                     KeyDown="UserInputTextBox_KeyDown"
                                     TextChanged="UserInputTextBox_TextChanged"/>

                            <TextBlock x:Name="PlaceholderText"
                                       Text="Enter task command..."
                                       Foreground="Gray"
                                       Margin="20,0,0,0"
                                       VerticalAlignment="Center"/>

                            <Button x:Name="SendButton"
                                    Width="50"
                                    Height="50"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment = "Center"
                                    Margin="0,0,5,0"
                                    Cursor = "Hand"
                                    Click="SendButton_Click">


                                <Button.ToolTip>

                                    <ToolTip Content = "Send Message"/>

                                </Button.ToolTip>


                                <Button.Template>

                                    <ControlTemplate TargetType = "Button">

                                        <Border Background = "#00C2FF"
                                                CornerRadius = "25"
                                                BorderBrush = "White"
                                                BorderThickness = "1">

                                            <ContentPresenter HorizontalAlignment = "Center"
                                                              VerticalAlignment = "Center"/>

                                        </Border>

                                    </ControlTemplate>
                                </Button.Template>

                                <TextBlock Text = "➤"
                                           FontSize = "18"
                                           FontWeight = "Bold"
                                           Foreground = "White"/>

                            </Button>

                            <!-- Hidden until needed -->

                            <DatePicker x:Name="ReminderDatePicker"
                                        Visibility="Collapsed"
                                        Width="220"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        SelectedDateChanged="ReminderDatePicker_SelectedDateChanged"/>

                        </Grid>

                    </Border>

                </Grid>

            </Border>

            <!-- RIGHT HELP PANEL -->

            <Border Grid.Column="2"
                    Background="white"
                    Margin="10"
                    CornerRadius="10">

                <StackPanel Margin="15">

                    <TextBlock Text="ℹ TASK HELP"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="Black"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="➕ Add Task"
                               FontWeight="Bold"
                               Foreground="#00C2FF"/>

                    <TextBlock Text="Create a cybersecurity task with a title, description and reminder."
                               TextWrapping="Wrap"
                               Foreground="Black"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="📋 View Tasks"
                               FontWeight="Bold"
                               Foreground="#00C2FF"/>

                    <TextBlock Text="Displays all tasks currently stored in the JSON file."
                               TextWrapping="Wrap"
                               Foreground="Black"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="✅ Complete Task"
                               FontWeight="Bold"
                               Foreground="#00C2FF"/>

                    <TextBlock Text="Marks a task as completed while keeping it in storage."
                               TextWrapping="Wrap"
                               Foreground="Black"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="🗑 Delete Task"
                               FontWeight="Bold"
                               Foreground="#00C2FF"/>

                    <TextBlock Text="Permanently removes a task from the JSON file."
                               TextWrapping="Wrap"
                               Foreground="Black"/>

                </StackPanel>

            </Border>

        </Grid>

        <!-- FOOTER -->

        <Border Grid.Row="3"
                Background="#10263A">

            <TextBlock Text="🛡️ Protecting South African Citizens Online 🛡️ Copyright Erwin Mashobane"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

        </Border>

    </Grid>

</Window>