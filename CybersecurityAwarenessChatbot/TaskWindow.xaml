<Window x:Class="CybersecurityAwarenessChatbot.TaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task Assistant"
        WindowState="Maximized"
        Background="#07111F">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="35"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#10263A">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="250"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton" 
                        Width="50" 
                        Height="50" 
                        Content="⬅" 
                        HorizontalAlignment="Right" 
                        VerticalAlignment="Center" 
                        Margin="0,0,5,0" 
                        Cursor="Hand" 
                        Click="BackButton_Click">
                    
                    <Button.ToolTip>
                        
                        <ToolTip Content="Back to Chat"/>
                        
                    </Button.ToolTip>
                    
                    <Button.Template>
                        
                        <ControlTemplate TargetType="Button">
                            
                            <Border Background="#00C2FF" CornerRadius="15">
                                
                                <ContentPresenter HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                                
                            </Border>
                            
                        </ControlTemplate>
                        
                    </Button.Template>
                    
                </Button>

                <TextBlock Grid.Column="1" 
                           Text="📋 CYBERSECURITY TASK ASSISTANT"
                           FontSize="28" 
                           FontWeight="Bold" 
                           Foreground="#00E5FF" 
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Center"/>

                <StackPanel Grid.Column="2" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Right" 
                            Margin="15">
                    
                    <Ellipse Width="14" 
                             Height="14" 
                             Fill="LimeGreen" 
                             VerticalAlignment="Center"/>
                    
                    <TextBlock x:Name="UserNameText" 
                               Foreground="White" 
                               FontSize="16" 
                               Margin="8,0,0,0" 
                               VerticalAlignment="Center"/>
                    
                </StackPanel>
                
            </Grid>
            
        </Border>

        <Grid Grid.Row="1">
            
            <Grid.ColumnDefinitions>
                
                <ColumnDefinition Width="300"/>
                
                <ColumnDefinition Width="*"/>
                
                <ColumnDefinition Width="350"/>
                
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0D1B2A" Margin="10" CornerRadius="10">
                
                <StackPanel>
                    
                    <TextBlock Text="TASK MENU" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="#00E5FF" 
                               Margin="15"/>

                    <TextBlock Text="➕ Add Task" 
                               Cursor="Hand" 
                               Margin="15" 
                               Foreground="White" 
                               PreviewMouseDown="AddTaskOption_Click"/>
                    
                    <TextBlock Text="📋 View Tasks" 
                               Cursor="Hand" 
                               Margin="15" 
                               Foreground="White"
                               PreviewMouseDown="ViewTasksOption_Click"/>
                    
                    <TextBlock Text="✅ Complete Task" 
                               Cursor="Hand" 
                               Margin="15" 
                               Foreground="White" 
                               PreviewMouseDown="CompleteTaskOption_Click"/>
                    
                    <TextBlock Text="🗑 Delete Task" Cursor="Hand" 
                               Margin="15" Foreground="White" 
                               PreviewMouseDown="DeleteTaskOption_Click"/>
                    
                    <TextBlock Text="🔔 View Reminders" 
                               Cursor="Hand" 
                               Margin="15" 
                               Foreground="White" 
                               PreviewMouseDown="ViewRemindersTaskOption_Click"/>
                </StackPanel>
                
            </Border>

            <Border Grid.Column="1" 
                    Margin="10" 
                    Background="LightGray" 
                    CornerRadius="15">
                
                <Grid>
                    
                    <Grid.RowDefinitions>
                        
                        <RowDefinition Height="*"/>
                        
                        <RowDefinition Height="80"/>
                        
                    </Grid.RowDefinitions>

                    <ScrollViewer x:Name="ChatScrollViewer" 
                                  Grid.Row="0">
                        
                        <StackPanel x:Name="ChatPanel"/>
                        
                    </ScrollViewer>

                    <Border Grid.Row="1" 
                            Margin="10" 
                            Background="White" 
                            CornerRadius="30">
                        
                        <Grid>
                            
                            <TextBox x:Name="UserInputTextBox" 
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     FontSize="18" 
                                     Padding="20,0,70,0" 
                                     VerticalContentAlignment="Center" 
                                     KeyDown="UserInputTextBox_KeyDown" 
                                     TextChanged="UserInputTextBox_TextChanged"/>
                            
                            <TextBlock x:Name="PlaceholderText" 
                                       Text="Enter task command..." 
                                       Foreground="Gray" 
                                       Margin="20,0,0,0" 
                                       VerticalAlignment="Center"/>

                            <Button x:Name="SendButton" 
                                    Width="50" 
                                    Height="50" 
                                    HorizontalAlignment="Right" 
                                    VerticalAlignment="Center" 
                                    Margin="0,0,5,0" 
                                    Cursor="Hand" 
                                    Click="SendButton_Click">
                                
                                <Button.ToolTip>
                                    
                                    <ToolTip Content="Send Message"/>
                                    
                                </Button.ToolTip>
                                
                                <Button.Template>
                                    
                                    <ControlTemplate TargetType="Button">
                                        
                                        <Border Background="#00C2FF" 
                                                CornerRadius="25" 
                                                BorderBrush="White" 
                                                BorderThickness="1">
                                            
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                              VerticalAlignment="Center"/>
                                            
                                        </Border>
                                        
                                    </ControlTemplate>
                                    
                                </Button.Template>
                                
                                <TextBlock Text="➤" 
                                           FontSize="18" 
                                           FontWeight="Bold" 
                                           Foreground="White"/>
                                
                            </Button>

                            <DatePicker x:Name="ReminderDatePicker" 
                                        Visibility="Collapsed" 
                                        Width="220" 
                                        HorizontalAlignment="Center" 
                                        VerticalAlignment="Center"/>
                            
                        </Grid>
                        
                    </Border>
                    
                </Grid>
                
            </Border>


            <Border Grid.Column="2" 
                    Background="#10263A"
                    CornerRadius="10" 
                    Margin="5" 
                    Padding="10">
                
                <StackPanel Margin="15">
                    
                    <TextBlock Text="📋 TASK HELP" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="#00E5FF" 
                               Margin="0,0,0,10"/>
                    
                    <TextBlock Text="➕ Add Task" 
                               Foreground="White" 
                               Margin="0,3"/>
                    
                    <TextBlock Text="📋 View Tasks" 
                               Foreground="White" 
                               Margin="0,3"/>
                    
                    <TextBlock Text="✅ Complete Task" 
                               Foreground="White" 
                               Margin="0,3"/>
                    
                    <TextBlock Text="🗑 Delete Task" 
                               Foreground="White" 
                               Margin="0,3"/>
                    
                    <TextBlock Text="🔔 Add Reminder" 
                               Foreground="White" 
                               Margin="0,3"/>

                    <Separator Margin="0,0,0,15"/>

                    <TextBlock Text="📜 ACTIVITY LOG" 
                               FontSize="18" 
                               FontWeight="Bold" 
                               Foreground="#00E5FF" 
                               Margin="0,0,0,10"/>
                    
                    <ScrollViewer Height="300" 
                                  VerticalScrollBarVisibility="Auto">
                        
                        <TextBlock x:Name="ActivityLogTextBox" 
                                   Foreground="White" 
                                   TextWrapping="Wrap" 
                                   FontSize="12"/>
                    </ScrollViewer>

                    <Button x:Name="ViewJsonButton" 
                            Content="📁 View Saved JSON" 
                            Height="40" 
                            Margin="0,15,0,0" 
                            Click="ViewJsonTasksButton_Click"/>
                    
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="3" 
                Background="#10263A">
            
            <TextBlock Text="🛡️ Protecting South African Citizens Online • SecureWin 2026 🛡️ Erwin Mashobane" 
                       Foreground="White" 
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>