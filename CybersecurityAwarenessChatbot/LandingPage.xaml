<Window x:Class="CybersecurityAwarenessChatbot.LandingPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SecureWin Cybersecurity Assistant"
        Height="950"
        Width="1600"
        Background="#07111F"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Loaded="LandingPage_Loaded">
    
       

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="150"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="250"/>
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="AsciiArtText"
            Grid.Row="0"
            Foreground="#00E5FF"
            FontFamily="Consolas"
            FontSize="11"
            TextAlignment="Center"
            VerticalAlignment="Center"/>

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center">

            <TextBlock
                Text="Enter Your Name"
                Foreground="White"
                FontSize="24"
                HorizontalAlignment="Center"/>

            <TextBox
                x:Name="NameTextBox"
                Width="300"
                Height="40"
                Margin="0,10"/>

            <TextBlock x:Name="UserNameText"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Right"
                       Margin="0,10,20,0"/>

        </StackPanel>
        <!-- Chat Area -->
        <Border Grid.Row="1"
                Margin="10"
                CornerRadius="10"
                Background="White"
                BorderBrush="Gray"
                BorderThickness="1">

            <ScrollViewer x:Name="ChatScrollViewer"
                  VerticalScrollBarVisibility="Auto">

                <StackPanel x:Name="ChatPanel"
                    Margin="10"/>

            </ScrollViewer>

        </Border>

        <!-- User Input -->
        <Grid Grid.Row="2" Margin="10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="UserInputTextBox"
                     Grid.Column="0"
                     Height="40"
                     FontSize="16"
                     VerticalContentAlignment="Center"
                     KeyDown="UserInputTextBox_KeyDown"/>

            <Button x:Name="SendButton"
                    Grid.Column="1"
                    Content="Send"
                    Margin="10,0,0,0"
                    Click="SendButton_Click"/>

        </Grid>
        <!-- ================================================= -->
        <!-- BUTTONS + FOOTER -->
        <!-- ================================================= -->

        <StackPanel Grid.Row="3"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="10">

            <Button x:Name="ChatButton"
                    Content="1. Chat Mode"
                    Width="220"
                    Height="60"
                    Margin="10"
                    Click="ChatButton_Click"/>

            <Button x:Name="QuizButton"
                    Content="2. Quiz Mode"
                    Width="220"
                    Height="60"
                    Margin="10"
                    Click="QuizButton_Click"/>

            <Button x:Name="TaskButton"
                    Content="3. Task Mode"
                    Width="220"
                    Height="60"
                    Margin="10"
                    Click="TaskButton_Click"/>

            <Button x:Name="ExitButton"
                    Content="4. Exit"
                    Width="220"
                    Height="60"
                    Margin="10"
                    Click="ExitButton_Click"/>

        </StackPanel>

        <!-- ================================================= -->
        <!-- FOOTER -->
        <!-- ================================================= -->

        <Border Grid.Row="3"
                Background="#10263A"
                Height="35">

            <TextBlock
                    Text="🛡️ Protecting South African Citizens Online 🛡️"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>

        </Border>

        </StackPanel>

    </Grid>   

</Window>