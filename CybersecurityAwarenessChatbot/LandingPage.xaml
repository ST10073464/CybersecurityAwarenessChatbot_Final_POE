<Window x:Class="CybersecurityAwarenessChatbot.LandingPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SecureWin Cybersecurity Assistant"
        Height="950"
        Width="1600"
        Background="#07111F"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Loaded="LandingPage_Loaded">
    
    <Grid Margin="20">

        <Grid.RowDefinitions>

            <!-- Logo -->
            <RowDefinition Height = "150"/>

            <!-- Chat Area -->
            <RowDefinition Height = "180"/>

            <!-- Input Area -->
            <RowDefinition Height = "Auto"/>

            <!-- Buttons -->
            <RowDefinition Height = "Auto"/>

            <!-- Footer -->
            <RowDefinition Height = "35"/>
            
        </Grid.RowDefinitions>

        <TextBlock Text = "🔒 SECUREWIN CYBERSECURITY ASSISTANT 🔒"
                    Foreground = "#00E5FF"
                    FontSize = "18"
                    FontWeight = "Bold"
                    HorizontalAlignment = "Center"
                    Margin = "0,0,0,5"/>

        <TextBlock x:Name="AsciiArtText"
                    Grid.Row="0"
                    Foreground="#00E5FF"
                    FontFamily="Consolas"
                    FontSize="11"
                    TextAlignment="Center"
                    VerticalAlignment="Center"/>

        <!-- ================================================= -->
        <!-- Chat Area -->
        <!-- ================================================= -->

        <Border x:Name="ChatArea"
                Grid.Row="1"
                Margin = "10"
                CornerRadius = "10"
                Background = "White"
                BorderBrush = "Gray"
                BorderThickness = "1">

            <ScrollViewer x:Name = "ChatScrollViewer"
                          VerticalScrollBarVisibility = "Auto">

                <StackPanel x:Name = "ChatPanel"
                            Margin = "10"/>

            </ScrollViewer>

        </Border>
        
        <!-- ================================================= -->
        <!-- WELCOME MESSAGE -->
        <!-- ================================================= -->

        <TextBlock x:Name="WelcomeText"
           Grid.Row="1"
           Visibility="Collapsed"
           Foreground="White"
           FontSize="30"
           FontWeight="Bold"
           TextAlignment="Center"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           TextWrapping="Wrap"/>

        <!-- ================================================= -->
        <!-- INPUT AREA -->
        <!-- ================================================= -->

        <Grid Grid.Row="2">

            <Border x:Name="InputArea"
                Margin = "10"
                Background = "White"
                CornerRadius = "30"
                BorderBrush = "#00C2FF"
                BorderThickness = "2"
                Height = "60">

            <Grid>

                <TextBox x:Name = "UserInputTextBox"
                         BorderThickness = "0"
                         Background = "Transparent"
                         FontSize = "18"
                         Padding = "20,0,80,0"
                         VerticalContentAlignment = "Center"
                         TextChanged = "UserInputTextBox_TextChanged"
                         KeyDown = "UserInputTextBox_KeyDown"/>

                <TextBlock x:Name = "PlaceholderText"
                           Text = "Enter your name..."
                           Foreground = "Gray"
                           FontSize = "16"
                           Margin = "20,0,0,0"
                           VerticalAlignment = "Center"
                           IsHitTestVisible = "False"/>

                    <Button x:Name = "SendButton"
                        Width = "50"
                        Height = "50"
                        HorizontalAlignment = "Right"
                        VerticalAlignment = "Center"
                        Margin = "0,0,5,0"
                        Click = "SendButton_Click"
                        Cursor="Hand">

                        <Button.ToolTip>

                            <ToolTip Content="Send Prompt"/>

                        </Button.ToolTip>


                        <Button.Template>
                        
                        <ControlTemplate TargetType = "Button">
                            
                            <Border Background = "#00C2FF"
                                    CornerRadius = "25"
                                    BorderThickness="1">
                                
                                    <ContentPresenter HorizontalAlignment = "Center"
                                                  VerticalAlignment = "Center"/>
                                
                            </Border>
                            
                        </ControlTemplate>
                        
                    </Button.Template>

                    <TextBlock Text = "➤"
                               FontSize = "18"
                               FontWeight = "Bold"
                               Foreground = "White"/>

                </Button>

            </Grid>

        </Border>

        </Grid>

        <!-- ================================================= -->
        <!-- BUTTONS + FOOTER -->
        <!-- ================================================= -->

        <StackPanel x:Name="ModeButtonsPanel"
                    Grid.Row="3"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed">
            
            <StackPanel Grid.Row = "3"
                        Orientation = "Horizontal"
                        HorizontalAlignment = "Center"
                        VerticalAlignment = "Center"
                        Margin = "10">

            <Button x:Name = "ChatButton"
                    Content = "Chat Mode"
                    Width = "220"
                    Height = "60"
                    Margin = "10"
                    Click = "ChatButton_Click"/>

            <Button x:Name = "QuizButton"
                    Content = "Quiz Mode"
                    Width = "220"
                    Height = "60"
                    Margin = "10"
                    Click = "QuizButton_Click"/>

            <Button x:Name = "TaskButton"
                    Content = "Task Mode"
                    Width = "220"
                    Height = "60"
                    Margin = "10"
                    Click = "TaskButton_Click"/>

                <Button x:Name = "LeaveSessionButton"
                        Content = "🚪 Leave Session"
                        Width = "220"
                        Height = "60"
                        Margin = "10"
                        Click = "LeaveSessionButton_Click"/>

                <Button x:Name = "ExitButton"
                    Content = "Exit"
                    Width = "220"
                    Height = "60"
                    Margin = "10"
                    Click = "ExitButton_Click"/>

        </StackPanel>

        <!-- ================================================= -->
        <!-- FOOTER -->
        <!-- ================================================= -->

        <Border Grid.Row = "3"
                Background = "#10263A"
                Height = "35">

            <TextBlock
                    Text = "🛡️ Protecting South African Citizens Online 🛡️"
                    Foreground = "White"
                    FontSize = "14"
                    FontWeight = "Bold"
                    HorizontalAlignment = "Center"
                    VerticalAlignment = "Center"/>

        </Border>

        </StackPanel>

    </Grid>   

</Window>