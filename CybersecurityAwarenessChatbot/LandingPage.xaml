<Window x:Class="CybersecurityAwarenessChatbot.LandingPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SecureWin"
        Height="700"
        Width="1200"
        Background="#07111F"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="200"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="AsciiArtText"
            Grid.Row="0"
            Foreground="#00E5FF"
            FontFamily="Consolas"
            FontSize="11"
            TextAlignment="Center"
            VerticalAlignment="Center"/>

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center">

            <TextBlock
                Text="Enter Your Name"
                Foreground="White"
                FontSize="24"
                HorizontalAlignment="Center"/>

            <TextBox
                x:Name="NameTextBox"
                Width="300"
                Height="40"
                Margin="0,10"/>

            <Button
                x:Name="ContinueButton"
                Content="Continue"
                Width="150"
                Height="40"
                Click="ContinueButton_Click"/>

        </StackPanel>

        <StackPanel Grid.Row="2"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <Button x:Name="ChatButton"
                    Content="1. Chat Mode"
                    Width="250"
                    Height="60"
                    Margin="10"
                    Click="ChatButton_Click"/>

            <Button x:Name="QuizButton"
                    Content="2. Quiz Mode"
                    Width="250"
                    Height="60"
                    Margin="10"
                    Click="QuizButton_Click"/>

            <Button x:Name="TaskButton"
                    Content="3. Task Mode"
                    Width="250"
                    Height="60"
                    Margin="10"
                    Click="TaskButton_Click"/>

            <Button x:Name="ExitButton"
                    Content="4. Exit"
                    Width="250"
                    Height="60"
                    Margin="10"
                    Click="ExitButton_Click"/>

        </StackPanel>

    </Grid>

</Window>