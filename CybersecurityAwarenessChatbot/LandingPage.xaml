<Window x:Class = "CybersecurityAwarenessChatbot.LandingPage"
        xmlns = "http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x = "http://schemas.microsoft.com/winfx/2006/xaml"
        Title = "SecureWin Cybersecurity Assistant"
        Height = "950"
        Width = "1600"
        Background = "#07111F"
        WindowStartupLocation = "CenterScreen"
        WindowState = "Maximized"
        Loaded = "LandingPage_Loaded">

    <Grid Margin="20">

        <Grid.RowDefinitions>

            <!-- Header -->
            <RowDefinition Height = "150"/>

            <!-- Chat Area -->
            <RowDefinition Height = "*"/>

            <!-- Input Area -->
            <RowDefinition Height = "80"/>

            <!-- Footer -->
            <RowDefinition Height = "35"/>

        </Grid.RowDefinitions>


        <!-- ================================================= -->
        <!-- TITLE -->
        <!-- ================================================= -->

        <TextBlock Text = "🔒 SECUREWIN CYBERSECURITY ASSISTANT 🔒"
                    Foreground = "#00E5FF"
                    FontSize = "18"
                    FontWeight = "Bold"
                    HorizontalAlignment = "Center"
                    Margin = "0,0,0,5"/>

        <!-- ================================================= -->
        <!-- ASCII LOGO -->
        <!-- ================================================= -->

        <TextBlock x:Name="AsciiArtText"
                    Grid.Row="0"
                    Foreground="#00E5FF"
                    FontFamily="Consolas"
                    FontSize="11"
                    TextAlignment="Center"
                    VerticalAlignment="Center"/>

        <!-- ================================================= -->
        <!-- Chat Area -->
        <!-- ================================================= -->

        <Border x:Name = "ChatArea" 
                Grid.Row = "1" 
                Width = "500" 
                Height = "300" 
                HorizontalAlignment = "Center" 
                Background = "LightGray" 
                CornerRadius = "20" 
                BorderBrush = "#D0D0D0" 
                BorderThickness = "1">

            <Grid>
                
                <Grid.RowDefinitions>
                    
                    <RowDefinition Height = "*"/>
                    
                    <RowDefinition Height = "80"/>
                    
                </Grid.RowDefinitions>
                
                <!-- CHAT CONTENT -->
                
                <Grid Grid.Row = "0">
                    
                    <ScrollViewer x:Name = "ChatScrollViewer" 
                                  VerticalScrollBarVisibility="Auto">
                        
                        <StackPanel x:Name = "ChatPanel" 
                                    Margin = "15"/>
                        
                    </ScrollViewer>
                  
                   
                </Grid>
                
                <!-- INPUT AREA -->
                
                <Border x:Name = "InputArea" 
                        Grid.Row = "1" 
                        Margin = "10" 
                        Background = "White"                        
                        Height="60"                       
                        CornerRadius = "30">
                    
                    <Grid>
                        <TextBox x:Name = "UserInputTextBox" 
                                 BorderThickness = "0" 
                                 Background = "Transparent" 
                                 FontSize = "18" 
                                 Padding = "20,0,70,0"
                                 VerticalContentAlignment = "Center" 
                                 TextChanged = "UserInputTextBox_TextChanged" 
                                 KeyDown = "UserInputTextBox_KeyDown"/>
                        
                        <TextBlock x:Name = "PlaceholderText" 
                                   Text ="Enter your name..." 
                                   Foreground = "Gray" 
                                   FontSize = "16" 
                                   Margin = "20,0,0,0" 
                                   VerticalAlignment = "Center" 
                                   IsHitTestVisible = "False"/>
                        
                        <Button x:Name = "SendButton" 
                                Width = "50" Height = "50" 
                                HorizontalAlignment = "Right" 
                                VerticalAlignment = "Center" 
                                Margin = "0,0,5,0" 
                                Cursor = "Hand" 
                                Click = "SendButton_Click">
                            
                            <Button.ToolTip>
                                
                                <ToolTip Content = "Send Prompt"/>
                                
                            </Button.ToolTip>
                            
                            <Button.Template>
                                
                                <ControlTemplate TargetType = "Button">
                                    
                                    <Border Background = "#00C2FF" 
                                            CornerRadius = "25">
                                        
                                        <ContentPresenter HorizontalAlignment = "Center" 
                                                          VerticalAlignment = "Center"/>
                                        
                                    </Border>
                                    
                                </ControlTemplate>
                                
                            </Button.Template>
                            
                            <TextBlock Text = "➤" 
                                       Foreground ="White" 
                                       FontWeight = "Bold" 
                                       FontSize = "18"/>
                            
                        </Button>
                        
                    </Grid>
                    
                </Border>
                
            </Grid>
            
        </Border>

        <!-- ================================================= -->
        <!-- WELCOME MESSAGE -->
        <!-- ================================================= -->

        <TextBlock x:Name = "WelcomeText"
                    Grid.Row = "1"
                    Visibility = "Collapsed"
                    Foreground = "White"
                    FontSize = "30"
                    FontWeight = "Bold"
                    TextAlignment = "Center"
                    HorizontalAlignment = "Center"
                    VerticalAlignment = "Center"
                    TextWrapping = "Wrap"/>

        <!-- ================================================= -->
        <!-- BUTTONS + FOOTER -->
        <!-- ================================================= -->

        <StackPanel x:Name = "ModeButtonsPanel"
            Grid.Row = "3"
            HorizontalAlignment = "Center"
            VerticalAlignment = "Center"
            Visibility = "Collapsed">

            <!-- First Row -->
            <StackPanel Orientation = "Horizontal"
                HorizontalAlignment = "Center"
                Margin = "10">

               
            </StackPanel>

            <!-- Second Row -->
            <StackPanel Orientation = "Horizontal"
                HorizontalAlignment = "Center"
                Margin = "10,0,10,10">

                <Button x:Name = "LeaveSessionButton"
                Content = "🚪 Leave Session"
                Width = "220"
                Height = "60"
                Margin = "10"
                Click = "LeaveSessionButton_Click"/>

                <Button x:Name = "ExitButton"
                Content = "❌ Exit"
                Width = "220"
                Height = "60"
                Margin = "10"
                Click = "ExitButton_Click"/>

            </StackPanel>

            <!-- Footer -->
            <!-- FOOTER -->

           


        </StackPanel>
        <Border Grid.Row="4"
         Background="#10263A">

            <TextBlock Text="🛡️ Protecting South African Citizens Online 🛡️ Copyright Erwin Mashobane"
                Foreground="White"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"/>

        </Border>

    </Grid>
    

</Window>