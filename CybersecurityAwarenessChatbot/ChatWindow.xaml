<Window x:Class="CybersecurityAwarenessChatbot.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SecureWin Cybersecurity Assistant"
        WindowState="Maximized"
        Background="#07111F">

    <Grid>

        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height = "160"/>

            <!-- Chat Area -->
            <RowDefinition Height = "*"/>

            <!-- Input Area -->
            <RowDefinition Height = "80"/>

            <!-- Footer -->
            <RowDefinition Height = "35"/>

        </Grid.RowDefinitions>
        

        <!-- ================================================= -->
        <!-- HEADER -->
        <!-- ================================================= -->

        <Border Grid.Row="0"
                Background="#081520">

            <Grid Margin="15">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="250"/>

                    <ColumnDefinition Width="*"/>

                    <ColumnDefinition Width="250"/>

                </Grid.ColumnDefinitions>

                <!-- LEFT -->

                <Button Grid.Column="0"
                        Background = "#00C2FF" 
                        Content="🚪 Leave Session"
                        Width="120"
                        Height="40"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Foreground = "White"
                        Margin="10"
                        Click="BackButton_Click"/>

                <!-- CENTER -->

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <!-- ================================================= -->
                    <!-- TITLE -->
                    <!-- ================================================= -->

                    <TextBlock Text = "🔒 SECUREWIN CYBERSECURITY ASSISTANT 🔒"
                               Foreground = "#00E5FF"
                               FontSize = "18"
                               FontWeight = "Bold"
                               HorizontalAlignment = "Center"
                               Margin = "0,0,0,5"/>

                    <!-- ================================================= -->
                    <!-- ASCII LOGO -->
                    <!-- ================================================= -->

                    <TextBlock x:Name="AsciiArtText"
                               Foreground="#00E5FF"
                               FontFamily="Consolas"
                               FontSize="11"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextWrapping="NoWrap"/>

                </StackPanel>

                <!-- USER -->

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="15">

                    <Ellipse Width="14"
                             Height="14"
                             Fill="LimeGreen"
                             VerticalAlignment="Center"/>

                    <TextBlock x:Name="UserNameText"
                               Foreground="White"
                               FontSize="16"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"/>

                </StackPanel>
            </Grid>

        </Border>

        <!-- ================================================= -->
        <!-- BODY -->
        <!-- ================================================= -->
        
        <Grid Grid.Row="1"
              Margin="10">

            <Grid.ColumnDefinitions>

                <!-- LEFT MENU -->
                <ColumnDefinition Width="250"/>

                <!-- CHAT -->
                <ColumnDefinition Width="*"/>

                <!-- RIGHT PANEL -->
                <ColumnDefinition Width="250"/>

            </Grid.ColumnDefinitions>
            

            <!-- ================================================= -->
            <!-- LEFT SIDEBAR -->
            <!-- ================================================= -->

            <Border Grid.Column="0"
                    Background="#0D1B2A"
                    CornerRadius="10"
                    Padding="15"
                    Margin="0,0,5,0">

                <StackPanel Margin="0,-5,-5,0">

                    <TextBlock Text="📋 AVAILABLE FEATURES"
                               Foreground="#00E5FF"
                               FontWeight="Bold"
                               FontSize="18"
                               Margin="0,0,0,15"/>

                    <TextBlock Text="🔒 Passwords"
                               Foreground="White"
                               Margin="0,4"/>

                    <TextBlock Text="🎣 Phishing"
                               Foreground="White"
                               Margin="0,4"/>

                    <TextBlock Text="🛡️ Privacy"
                               Foreground="White"
                               Margin="0,4"/>

                    <TextBlock Text="💻 Malware"
                               Foreground="White"
                               Margin="0,4"/>

                    <TextBlock Text="⚠️ Scams"
                               Foreground="White"
                               Margin="0,4"/>

                    <Separator Margin="0,10"/>

                    <TextBlock Text="📋 Add Task"
                               Foreground="#00E5FF"
                               Margin="0,4"/>

                    <TextBlock Text="📋 View Tasks"
                               Foreground="#00E5FF"
                               Margin="0,4"/>

                    <TextBlock Text="🗑 Delete Task"
                               Foreground="#00E5FF"
                               Margin="0,4"/>

                    <TextBlock Text="✅ Complete Task"
                               Foreground="#00E5FF"
                               Margin="0,4"/>

                    <Separator Margin="0,10"/>

                    <TextBlock Text="🎮 Start Quiz"
                               Foreground="#00E5FF"
                               Margin="0,4"/>

                    <TextBlock Text="📜 Activity Log"
                               Foreground="#00E5FF"
                               Margin="0,4"/>

                </StackPanel>

            </Border>

            <!-- ================================================= -->
            <!-- CHAT AREA -->
            <!-- ================================================= -->

            <Border Grid.Column="1"
                    Background="LightGray"
                    CornerRadius="10"
                    Padding="10">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="70"/>
                    </Grid.RowDefinitions>

                    <!-- CHAT -->

                    <ScrollViewer x:Name="ChatScrollViewer"
                                  Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto" Grid.ColumnSpan="3">

                        <StackPanel x:Name="ChatPanel"/>

                    </ScrollViewer>

                    <!-- INPUT -->

                    <Border Grid.Row="1"
                            Background="White"
                            CornerRadius="30"
                            Margin="5,5,5,5" Grid.ColumnSpan="3">

                        <Grid>

                            <TextBox x:Name="UserInputTextBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="18"
                                     Padding="20,0,70,0"
                                     VerticalContentAlignment="Center"
                                     TextChanged="UserInputTextBox_TextChanged"
                                     KeyDown="UserInputTextBox_KeyDown"/>

                            <TextBlock x:Name="PlaceholderText"
                                       Text="Ask SecureWin anything..."
                                       Foreground="Gray"
                                       FontSize="16"
                                       Margin="20,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            
                            <Button x:Name = "SendButton" 
                                    Width = "50" Height = "50" 
                                    HorizontalAlignment = "Right" 
                                    VerticalAlignment = "Center" 
                                    Margin = "0,0,5,0" 
                                    Cursor = "Hand" 
                                    Click = "SendButton_Click">

                                <Button.ToolTip>

                                    <ToolTip Content = "Send Prompt"/>

                                </Button.ToolTip>

                                <Button.Template>

                                    <ControlTemplate TargetType = "Button">

                                        <Border Background = "#00C2FF" 
                                                CornerRadius = "25">

                                            <ContentPresenter HorizontalAlignment = "Center" 
                                                              VerticalAlignment = "Center"/>

                                        </Border>

                                    </ControlTemplate>

                                </Button.Template>

                                <TextBlock Text = "➤" 
                                            Foreground ="White" 
                                            FontWeight = "Bold" 
                                            FontSize = "18"/>

                            </Button>

                        </Grid>

                    </Border>

                </Grid>

            </Border>

            <!-- ================================================= -->
            <!-- RIGHT SIDE -->
            <!-- ================================================= -->
            <Border Grid.Column="2"
                    Background="#0D1B2A"
                    CornerRadius="15"
                    Margin="10,0,0,0"
                    Padding="10">

                <StackPanel>

                    <TextBlock Text="🛡 CYBERSECURITY"
                               Foreground="#00E5FF"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,15"/>      
                    
                            <TextBlock Text="✅ Malware Protection"
                                       Foreground="White"
                                       FontSize="12"
                                       Margin="0,4"/>

                            <TextBlock Text="✅ VPN Security"
                                       Foreground="White"
                                       FontSize="12"
                                       Margin="0,4"/>

                            <TextBlock Text="✅ Ransomware Safety"
                                       Foreground="White"
                                       FontSize="12"
                                       Margin="0,4"/>

                            <TextBlock Text="✅ Sentiment Detection"
                                       Foreground="White"
                                       FontSize="12"
                                       Margin="0,4"/>

                            <TextBlock Text="✅ Smart Conversations"
                                       Foreground="White"
                                       FontSize="12"
                                       Margin="0,4"/>

                            <TextBlock Text="✅ Activity Logging"
                                       Foreground="White"
                                       FontSize="12"
                                       Margin="0,4"/>                                    

                            <TextBlock Text="✅ Password Safety"
                                       Foreground="White"
                                       FontSize="12"
                                       Margin="0,4"/>

                            <TextBlock Text="✅ Phishing Detection"
                                       Foreground="White"
                                       FontSize="12"
                                       Margin="0,4"/>

                            <TextBlock Text="✅ Scam Awareness"
                                       Foreground="White"
                                       FontSize="12"
                                       Margin="0,4"/>
                       

                    <Separator Margin="0,15"/>

                    <TextBlock Text="💡 TIP OF THE DAY"
                               Foreground="#00E5FF"
                               FontWeight="Bold"
                               FontSize="16"/>

                    <TextBlock TextWrapping="Wrap"
                               Foreground="White"
                               Margin="0,10,0,0"
                               Text="Never click a link in an email unless you verify the sender first. Phishing attacks often imitate trusted organisations."/>

                </StackPanel>

            </Border>

        </Grid>


        <Border Grid.Row="3"
                            Background="#081520">

            <TextBlock Text="🛡️ Protecting South African Citizens Online • SecureWin 2026"
                                Foreground="White"
                                FontSize="14"
                                FontWeight="Bold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

        </Border>

    </Grid>

</Window>

