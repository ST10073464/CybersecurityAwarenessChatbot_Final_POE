<Window x:Class = "CybersecurityAwarenessChatbot.ChatWindow"
        xmlns = "http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x = "http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d = "http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc = "http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local = "clr-namespace:CybersecurityAwarenessChatbot"
        mc:Ignorable = "d"
        Title = "SecureWin Cybersecurity Assistant"
        Height = "950"
        Width = "1600"
        WindowStartupLocation = "CenterScreen"
        Background = "#07111F"
        WindowState = "Maximized">

    <!-- ========================================================= -->
    <!-- RESOURCES -->
    <!-- ========================================================= -->

    <Window.Resources>

        <!-- SEND BUTTON STYLE -->
        <Style x:Key = "CyberButton" TargetType="Button">

            <Setter Property = "Background"
                    Value = "#00C2FF"/>
            <Setter Property = "Foreground" 
                    Value = "White"/>
            <Setter Property = "FontWeight" 
                    Value = "Bold"/>
            <Setter Property = "FontSize" 
                    Value = "18"/>
            <Setter Property = "Cursor" 
                    Value = "Hand"/>
            <Setter Property = "BorderThickness" 
                    Value = "0"/>

        </Style>

    </Window.Resources>

    <!-- ========================================================= -->
    <!-- MAIN GRID -->
    <!-- ========================================================= -->

    <Grid Margin = "12">

        <Grid.RowDefinitions>

            <!-- HEADER -->
            <RowDefinition Height = "150"/>

            <!-- CHAT -->
            <RowDefinition Height = "*"/>

            <!-- INPUT -->
            <RowDefinition Height = "180"/>

        </Grid.RowDefinitions>

        <!-- ========================================================= -->
        <!-- HEADER -->
        <!-- ========================================================= -->

        <Border Grid.Row = "0"
                Background = "#081520">

            <Grid>

                <Grid.ColumnDefinitions>

                    <!-- LEFT -->
                    <ColumnDefinition Width = "3*"/>

                    <!-- RIGHT -->
                    <ColumnDefinition Width = "2*"/>

                </Grid.ColumnDefinitions>

                <!-- ================================================= -->
                <!-- LEFT SIDE -->
                <!-- ================================================= -->

                <Grid Grid.Column = "0">

                    <Grid.ColumnDefinitions>

                        <!-- USER -->
                        <ColumnDefinition Width = "220"/>

                        <!-- ASCII ART -->
                        <ColumnDefinition Width = "*"/>

                    </Grid.ColumnDefinitions>

                    <!-- ================================================= -->
                    <!-- USER PANEL -->
                    <!-- ================================================= -->

                    <Border Grid.Column = "0"
                            Background  = "#0D1B2A"
                            CornerRadius =   "12"
                            Padding = "10"
                            Margin = "0,0,10,0"
                            VerticalAlignment = "Stretch">

                        <StackPanel VerticalAlignment = "Center">

                            <TextBlock Foreground = "#00E5FF"
                                       FontSize = "14"
                                       FontWeight = "Bold"
                                       HorizontalAlignment = "Center"/>

                            <TextBlock x:Name = "UserNameText"
                                       Text = "Guest"
                                       Foreground = "White"
                                       FontSize = "18"
                                       FontWeight = "Bold"
                                       TextWrapping = "Wrap"
                                       TextAlignment = "Center"
                                       Margin = "0,10,0,0"/>

                        </StackPanel>

                    </Border>

                    <!-- ================================================= -->
                    <!-- Chat mode -->
                    <!-- ================================================= -->

                    <StackPanel Grid.Column = "1">

                        <TextBlock Text = "🔒 SECUREWIN CYBERSECURITY ASSISTANT 🔒"
                                   Foreground = "#00E5FF"
                                   FontSize = "18"
                                   FontWeight = "Bold"
                                   HorizontalAlignment = "Center"
                                   Margin = "0,0,0,5"/>

                        <TextBlock Text = "💬 Cybersecurity Chat"
                                   Foreground = "#00E5FF"
                                   FontFamily = "Consolas"
                                   FontSize = "18"
                                   FontWeight = "Bold"
                                   HorizontalAlignment = "Center"/>

                    </StackPanel>

                </Grid>
                
                <!-- ================================================= -->
                <!-- RIGHT SIDE -->
                <!-- ================================================= -->

                <Border Grid.Column = "1"
                        Background = "#0D1B2A"
                        CornerRadius = "15"
                        Margin = "10,0,0,0"
                        Padding = "10">

                    <StackPanel>

                        <TextBlock Text="🛡️ AVAILABLE FEATURES"
                                   Foreground = "White"
                                   FontSize = "16"
                                   FontWeight = "Bold"
                                   Margin = "0,0,0,10"/>

                        <Grid>

                            <Grid.ColumnDefinitions>

                                <ColumnDefinition Width = "*"/>
                                
                                <ColumnDefinition Width = "*"/>
                                
                                <ColumnDefinition Width = "*"/>

                            </Grid.ColumnDefinitions>

                            <!-- COLUMN 1 -->
                            <StackPanel Grid.Column = "0">

                                <TextBlock Text = "✅ Malware Protection"
                                           Foreground = "White"
                                           FontSize = "12"
                                           Margin = "0,4"/>

                                <TextBlock Text = "✅ VPN Security"
                                           Foreground = "White"
                                           FontSize = "12"
                                           Margin = "0,4"/>

                                <TextBlock Text = "✅ Ransomware Safety"
                                           Foreground = "White"
                                           FontSize = "12"
                                           Margin = "0,4"/>

                            </StackPanel>

                            <!-- COLUMN 2 -->
                            <StackPanel Grid.Column="1">

                                <TextBlock Text = "✅ Sentiment Detection"
                                           Foreground = "White"
                                           FontSize = "12"
                                           Margin = "0,4"/>

                                <TextBlock Text = "✅ Smart Conversations"
                                           Foreground = "White"
                                           FontSize = "12"
                                           Margin = "0,4"/>

                                <TextBlock Text = "✅ Emoji Messaging"
                                           Foreground = "White"
                                           FontSize = "12"
                                           Margin = "0,4"/>

                            </StackPanel>

                            <!-- COLUMN 3 -->
                            <StackPanel Grid.Column="2">

                                <TextBlock Text = "✅ Password Safety Tips"
                                           Foreground = "White"
                                           FontSize = "12"
                                           Margin = "0,4"/>

                                <TextBlock Text = "✅ Phishing Detection"
                                           Foreground = "White"
                                           FontSize = "12"
                                           Margin = "0,4"/>

                                <TextBlock Text = "✅ Scam Awareness"
                                           Foreground = "White"
                                           FontSize = "12"
                                           Margin = "0,4"/>

                            </StackPanel>

                        </Grid>

                    </StackPanel>

                </Border>

            </Grid>

        </Border>

        <!-- ========================================================= -->
        <!-- CHAT AREA + INPUT AREA -->
        <!-- ========================================================= -->

        <Border Grid.Row = "1"
                    Margin = "0,12"
                    Background = "LightGray"
                    CornerRadius = "15"                              
                    Padding = "10">

            <Grid>

                <Grid.RowDefinitions>

                    <!-- Messages -->
                    <RowDefinition Height = "*"/>

                    <!-- Input -->
                    <RowDefinition Height = "80"/>

                </Grid.RowDefinitions>

                <!-- ================================================= -->
                <!-- CHAT MESSAGES -->
                <!-- ================================================= -->

                <ScrollViewer Grid.Row = "0"
                              x:Name = "ChatScrollViewer"
                              VerticalScrollBarVisibility = "Auto">

                    <StackPanel x:Name = "ChatPanel"/>

                </ScrollViewer>

                <!-- ================================================= -->
                <!-- INPUT AREA -->
                <!-- ================================================= -->

                <Border Grid.Row = "1"
                        Margin = "5"
                        Background = "White"
                        CornerRadius = "30"
                       
                        Height = "60"
                        VerticalAlignment = "Center">

                    <Grid>

                        <!-- User Input -->

                        <TextBox x:Name = "UserInputTextBox"
                                 Background = "Transparent"
                                 BorderThickness = "0"
                                 FontSize = "18"
                                 Padding = "20,0,70,0"
                                 VerticalContentAlignment = "Center"
                                 Foreground = "Black"
                                 CaretBrush = "Black"
                                 KeyDown="UserInputTextBox_KeyDown"
                                 TextChanged="UserInputTextBox_TextChanged"/>

                        <!-- Placeholder -->

                        <TextBlock x:Name = "PlaceholderText"
                           Text = "Ask SecureWin anything about cybersecurity..."
                           Foreground = "Gray"
                           FontSize = "16"
                           Margin = "20,0,0,0"
                           VerticalAlignment = "Center"
                           IsHitTestVisible = "False"/>

                        <!-- Send Button -->

                        <Button x:Name = "SendButton"
                                Width = "50"
                                Height = "50"
                                HorizontalAlignment = "Right"
                                VerticalAlignment = "Center"
                                Margin = "0,0,5,0"
                                Cursor = "Hand"
                                Click = "SendButton_Click">

                            <Button.ToolTip>

                                <ToolTip Content = "Send Message"/>

                            </Button.ToolTip>

                            <Button.Template>

                                <ControlTemplate TargetType = "Button">

                                    <Border Background = "#00C2FF"
                                            CornerRadius = "25"
                                            BorderBrush = "White"
                                            BorderThickness = "1">

                                        <ContentPresenter HorizontalAlignment = "Center"
                                                  VerticalAlignment = "Center"/>

                                    </Border>

                                </ControlTemplate>
                            </Button.Template>

                            <TextBlock Text = "➤"
                               FontSize = "18"
                               FontWeight = "Bold"
                               Foreground = "White"/>

                        </Button>

                    </Grid>

                </Border>

            </Grid>

        </Border>

        <!-- ========================================================= -->
        <!-- FOOTER AREA -->
        <!-- ========================================================= -->

        <Border Grid.Row = "2"
                Background = "#081520">

            <Grid>

                <Grid.RowDefinitions>
                    
                    <RowDefinition Height = "Auto"/>
                    
                    <RowDefinition Height = "Auto"/>
                    
                </Grid.RowDefinitions>

                <!-- BACK BUTTON -->

                <Button Grid.Row = "0"
                        Content = "⬅ Back"
                        Width = "140"
                        Height = "40"
                        HorizontalAlignment = "Center"
                        Margin = "0,0,0,10"
                        Click = "BackButton_Click"/>

                <!-- FOOTER TEXT -->

                <TextBlock Grid.Row = "1"
                           Text = "🛡️ Protecting South African Citizens Online 🛡️"
                           Foreground = "White"
                           FontSize = "14"
                           FontWeight = "Bold"
                           HorizontalAlignment = "Center"
                           VerticalAlignment = "Center"/>

            </Grid>

        </Border>

    </Grid>

</Window>